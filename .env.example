# ==============================================================================
# JADS CLIENT ENVIRONMENT CONFIGURATION EXAMPLE (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. API Backend Configuration
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL="http://localhost:3000/api"

# Default Court Name (ใช้เติมเป็นค่าเริ่มต้นในเอกสารคดี)
NEXT_PUBLIC_DEFAULT_COURT="ศาลจังหวัดระยอง"

# ------------------------------------------------------------------------------
# 2. NextAuth & OAuth 2.0 Providers (Authentication)
# ------------------------------------------------------------------------------
# Secret used by NextAuth to encrypt session tokens
NEXTAUTH_SECRET="your_nextauth_session_secret_32_characters_long"

# The Canonical URL of your site (required in production for NextAuth callback)
NEXTAUTH_URL="http://localhost:3001"

# Google OAuth Credentials (https://console.cloud.google.com)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
